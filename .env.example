# Copy to `.env.local` and adjust. Every variable here is declared and validated
# in src/env.ts — the app refuses to build if one is missing or malformed.

NODE_ENV=development

# Backend runs on :3000 (see ../backend/.env.example), so the frontend takes :3001.
# Origin only — the generated client already carries the /api/v1 prefix in each path.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ENV=local

# Server-side only. Set when the API is reachable under a different hostname from
# the server than from the browser (Docker networks, private VPC endpoints).
# API_INTERNAL_URL=http://backend:3000

# The object store as the browser reaches it (the backend's STORAGE_ENDPOINT, or the
# bucket URL on AWS). File uploads PUT straight there, so the CSP must allow it; leave
# unset and every upload is blocked in the browser.
STORAGE_PUBLIC_URL=http://localhost:9000

# Where `pnpm api:generate` reads the OpenAPI document from. Defaults to the sibling
# backend checkout; point it at a deployed /api/docs/json when working solo.
OPENAPI_SOURCE=../backend/openapi.json

# NEXT_PUBLIC_SENTRY_DSN=

# Set ANALYZE=true to open the bundle treemap after `pnpm build`.
ANALYZE=false
