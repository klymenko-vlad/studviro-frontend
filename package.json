{
  "name": "@studviro/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Studviro web client — Next.js App Router, Feature-Sliced Design",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "analyze": "ANALYZE=true next build",
    "typegen": "next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "lint": "pnpm typegen && eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "pnpm typegen && eslint . --max-warnings 0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "steiger ./src",
    "arch:watch": "steiger ./src --watch",
    "cycles": "madge --circular --extensions ts,tsx src/",
    "deadcode": "knip",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:all": "pnpm test && pnpm test:e2e",
    "api:generate": "tsx scripts/generate-api.mts",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/shared/api/generated",
    "i18n:check": "tsx scripts/check-i18n.mts",
    "gen:slice": "tsx scripts/generate-slice.mts",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm arch && pnpm cycles && pnpm deadcode && pnpm i18n:check && pnpm test:cov && pnpm build && pnpm size",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-app": "^13.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unicorn": "^61.0.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^13.0.3",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
